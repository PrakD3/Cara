# Database Configuration
DATABASE_URL=postgresql://cara_user:cara_password@localhost:5432/cara_db
TEST_DATABASE_URL=postgresql://cara_user:cara_password@localhost:5432/cara_test_db

# Security
SECRET_KEY=generate_a_strong_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Exotel / Twilio IVR Integrations
IVR_SID=your_ivr_account_sid
IVR_AUTH_TOKEN=your_ivr_auth_token
IVR_WEBHOOK_URL=https://api.yourdomain.com/api/ivr/webhook

# AI Integrations (Groq, Wispr, Gemini)
GROQ_API_KEY=your_groq_api_key
WISPR_API_KEY=your_wispr_api_key
GEMINI_API_KEY=your_gemini_api_key

# Notifications
WHATSAPP_API_KEY=your_whatsapp_api_key
FCM_SERVER_KEY=your_fcm_server_key
